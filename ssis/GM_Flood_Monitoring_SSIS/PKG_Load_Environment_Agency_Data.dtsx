    <DTS:Executable
      DTS:refId="Package\09 - Record ETL Audit"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{64BBFF46-284F-491A-8555-EFEF844EC0D5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="09 - Record ETL Audit"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{56B8076A-B61A-4EEC-922E-FDEE3BC5257E}"
          SQLTask:SqlStatementSource="DECLARE @RunId NVARCHAR(100);&#xA;DECLARE @PipelineName NVARCHAR(255);&#xA;DECLARE @StartTimeUTC DATETIME2(7);&#xA;DECLARE @EndTimeUTC DATETIME2(7);&#xA;&#xA;DECLARE @RowsExtracted INT;&#xA;DECLARE @RowsLoaded INT;&#xA;DECLARE @RowsRejected INT;&#xA;&#xA;DECLARE @StationRows INT;&#xA;DECLARE @ReadingRows INT;&#xA;DECLARE @WarningRows INT;&#xA;&#xA;DECLARE @Status NVARCHAR(50);&#xA;DECLARE @DurationSeconds DECIMAL(18,3);&#xA;DECLARE @ErrorMessage NVARCHAR(MAX);&#xA;&#xA;SET @RunId = CONVERT(NVARCHAR(100), NEWID());&#xA;SET @PipelineName = N'GM_Flood_Monitoring_SSIS';&#xA;&#xA;SET @EndTimeUTC = SYSUTCDATETIME();&#xA;SET @StartTimeUTC = DATEADD(SECOND, -1, @EndTimeUTC);&#xA;&#xA;SELECT @StationRows = COUNT(*)&#xA;FROM stg.Station;&#xA;&#xA;SELECT @ReadingRows = COUNT(*)&#xA;FROM stg.RiverReading;&#xA;&#xA;SELECT @WarningRows = COUNT(*)&#xA;FROM stg.FloodWarning;&#xA;&#xA;SET @RowsLoaded =&#xA;    ISNULL(@StationRows, 0)&#xA;    + ISNULL(@ReadingRows, 0)&#xA;    + ISNULL(@WarningRows, 0);&#xA;&#xA;SET @RowsExtracted = @RowsLoaded;&#xA;SET @RowsRejected = 0;&#xA;&#xA;SET @Status = N'SUCCEEDED';&#xA;&#xA;SET @DurationSeconds =&#xA;    CAST(&#xA;        DATEDIFF_BIG(MILLISECOND, @StartTimeUTC, @EndTimeUTC) / 1000.0&#xA;        AS DECIMAL(18,3)&#xA;    );&#xA;&#xA;SET @ErrorMessage = NULL;&#xA;&#xA;EXEC audit.usp_LogETLExecution&#xA;    @RunId = @RunId,&#xA;    @PipelineName = @PipelineName,&#xA;    @StartTimeUTC = @StartTimeUTC,&#xA;    @EndTimeUTC = @EndTimeUTC,&#xA;    @RowsExtracted = @RowsExtracted,&#xA;    @RowsLoaded = @RowsLoaded,&#xA;    @RowsRejected = @RowsRejected,&#xA;    @StationRows = @StationRows,&#xA;    @ReadingRows = @ReadingRows,&#xA;    @WarningRows = @WarningRows,&#xA;    @Status = @Status,&#xA;    @DurationSeconds = @DurationSeconds,&#xA;    @ErrorMessage = @ErrorMessage;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
