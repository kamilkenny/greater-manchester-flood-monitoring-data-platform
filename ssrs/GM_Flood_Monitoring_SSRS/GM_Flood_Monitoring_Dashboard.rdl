    <DataSet Name="DS_KPIs">
      <Query>
        <DataSourceName>GM_Flood_Monitoring_AzureSQL</DataSourceName>
        <CommandText>SELECT
    (SELECT COUNT(DISTINCT StationKey)
     FROM dbo.vw_CurrentStationStatus) AS MonitoredStations,

    (SELECT COUNT(*)
     FROM dbo.vw_HighRiverLevelStations) AS HighRiverLevelStations,

    (SELECT COUNT(*)
     FROM dbo.vw_FloodWarningSummary) AS ActiveFloodWarnings,

    (SELECT MAX(ReadingDateTimeUTC)
     FROM dbo.vw_CurrentStationStatus) AS LatestReadingUTC;</CommandText>
      </Query>
      <Fields>
        <Field Name="MonitoredStations">
          <DataField>MonitoredStations</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="HighRiverLevelStations">
          <DataField>HighRiverLevelStations</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ActiveFloodWarnings">
          <DataField>ActiveFloodWarnings</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LatestReadingUTC">
          <DataField>LatestReadingUTC</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_RiverTrend">
      <Query>
        <DataSourceName>GM_Flood_Monitoring_AzureSQL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@RiverName">
            <Value>=Parameters!RiverName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT TOP (200)
    s.StationName,
    s.RiverName,
    r.ReadingDateTimeUTC,
    r.ReadingValue
FROM dbo.FactRiverReading AS r
INNER JOIN dbo.DimStation AS s
    ON r.StationKey = s.StationKey
WHERE r.ReadingValue IS NOT NULL
  AND s.RiverName = @RiverName
ORDER BY r.ReadingDateTimeUTC ASC;</CommandText>
      </Query>
      <Fields>
        <Field Name="StationName">
          <DataField>StationName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RiverName">
          <DataField>RiverName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ReadingDateTimeUTC">
          <DataField>ReadingDateTimeUTC</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ReadingValue">
          <DataField>ReadingValue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_RiverList">
      <Query>
        <DataSourceName>GM_Flood_Monitoring_AzureSQL</DataSourceName>
        <CommandText>SELECT DISTINCT RiverName
FROM dbo.DimStation
WHERE RiverName IS NOT NULL
  AND LTRIM(RTRIM(RiverName)) &lt;&gt; ''
ORDER BY RiverName;</CommandText>
      </Query>
      <Fields>
        <Field Name="RiverName">
          <DataField>RiverName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_FloodWarnings">
      <Query>
        <DataSourceName>GM_Flood_Monitoring_AzureSQL</DataSourceName>
        <CommandText>SELECT TOP (10) *
FROM dbo.vw_FloodWarningSummary;</CommandText>
      </Query>
      <Fields>
        <Field Name="Severity">
          <DataField>Severity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SeverityLevel">
          <DataField>SeverityLevel</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="WarningCount">
          <DataField>WarningCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LatestUpdateUTC">
          <DataField>LatestUpdateUTC</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_ETLHealth">
      <Query>
        <DataSourceName>GM_Flood_Monitoring_AzureSQL</DataSourceName>
        <CommandText>SELECT TOP (1)
    RunId,
    PipelineName,
    StartTimeUTC,
    EndTimeUTC,
    RowsLoaded,
    RowsRejected,
    Status,
    DurationSeconds,
    ErrorMessage
FROM audit.ETLRunLog
ORDER BY StartTimeUTC DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="RunId">
          <DataField>RunId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PipelineName">
          <DataField>PipelineName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartTimeUTC">
          <DataField>StartTimeUTC</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EndTimeUTC">
          <DataField>EndTimeUTC</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="RowsLoaded">
          <DataField>RowsLoaded</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RowsRejected">
          <DataField>RowsRejected</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DurationSeconds">
          <DataField>DurationSeconds</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ErrorMessage">
          <DataField>ErrorMessage</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
