  <DataSets>
    <DataSet Name="DS_CurrentStationStatus">
      <Query>
        <DataSourceName>GM_Flood_Monitoring_AzureSQL</DataSourceName>
        <CommandText>SELECT *
FROM dbo.vw_CurrentStationStatus
ORDER BY StationName;</CommandText>
      </Query>
